# Credenciais do banco de dados PostgreSQL.
# Copie este arquivo para ".env" caso queira customizar os valores padrão
# (o docker-compose.yml já funciona sem essa cópia, usando os defaults
# definidos nele mesmo).
POSTGRES_USER=pedidos_user
POSTGRES_PASSWORD=pedidos_pass
POSTGRES_DB=pedidos_db

# String de conexão usada pela aplicação (SQLAlchemy + psycopg2).
# Dentro do Docker Compose, o host é o nome do serviço "postgres";
# fora do Compose (ex.: rodando a API localmente), troque por localhost.
DATABASE_URL=postgresql+psycopg2://pedidos_user:pedidos_pass@postgres:5432/pedidos_db
